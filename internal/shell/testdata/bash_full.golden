# zipline shell integration (bash)
dive() { \command zipline run dive -- "$@"; }
runlike() { \command zipline run runlike -- "$@"; }

zl() {
  \command zipline "$@"
  local __zipline_ret=$?
  if [ $__zipline_ret -eq 0 ]; then
    case "$1" in
      add|edit)
        eval "$(\command zipline init bash --funcs-only)"
        ;;
      remove|rm)
        eval "$(\command zipline init bash --funcs-only)"
        unset -f "$2" 2>/dev/null
        ;;
    esac
  fi
  return $__zipline_ret
}
